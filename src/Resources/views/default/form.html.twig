{% extends "@NovosgaPanel/base.html.twig" %}

{% trans_default_domain 'NovosgaPanelBundle' %}

{% block body %}
    <div class="d-flex">
        <div>
            <h1>
                <i class="fa fa-tv" aria-hidden="true"></i> {{ 'title'|trans }}
            </h1>
            <p>{{ 'subtitle'|trans }}</p>
        </div>
        <div class="ms-auto mt-3">
            {% if entity.id %}
                <a href="{{ path('painel_show', { publicId: entity.publicId }) }}" class="btn btn-outline-success ms-2" target="_blank">
                    <i class="fa fa-tv"></i>
                    {{ 'button.open_painel'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {{ form_start(form) }}

        {% include 'flashMessages.html.twig' %}

        <div class="row">
            <div class="col col-12 col-md-6 col-lg-4">
                {{ form_row(form.nome) }}
                
                <fieldset class="mt-4">
                    <legend class="fs-6 fw-semibold text-muted text-uppercase mb-3">{{ 'section.aparencia'|trans }}</legend>

                    {{ form_row(form.logo) }}

                    <div class="row row-cols-2">
                        <div class="col">
                            {{ form_row(form.corFundoDestaque) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoHistorico) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoRodape) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoRelogio) }}
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col col-12 col-md-6 col-lg-4">
                {{ form_row(form.servicos) }}
            </div>
            <div class="col offset-lg-1 col-12 col-lg-3">
                <div class="card border-secondary mb-4">
                    <div class="card-body">
                        <h5 class="card-title d-flex align-items-center gap-2">
                            <i class="fa fa-tv text-primary"></i>
                            <strong>Mangati Painel</strong>
                        </h5>
                        
                        <p class="text-muted small mb-3">
                            Precisa de mais liberdade para customizar seu painel? Conheça o <strong>Mangati Painel</strong>,
                            uma plataforma completa com templates, widgets e muito mais.
                        </p>
                        <ul class="list-unstyled small mb-4">
                            <li class="mb-1"><i class="bi bi-layout-text-window-reverse text-primary me-1"></i> Templates customizados</li>
                            <li class="mb-1"><i class="bi bi-puzzle text-primary me-1"></i> Integração com NovoSGA (v1.x, v2.x)</li>
                            <li class="mb-1"><i class="bi bi-cloud-sun text-primary me-1"></i> Clima e tempo</li>
                            <li class="mb-1"><i class="bi bi-newspaper text-primary me-1"></i> Notícias (RSS/Atom)</li>
                            <li class="mb-1"><i class="bi bi-youtube text-primary me-1"></i> YouTube e Playlist</li>
                            <li class="mb-1"><i class="bi bi-code-slash text-primary me-1"></i> HTML / iFrame</li>
                            <li class="mb-1"><i class="bi bi-megaphone text-primary me-1"></i> Comunicados</li>
                            <li class="mb-1"><i class="bi bi-tv text-primary me-1"></i> IPTV</li>
                        </ul>
                        <a href="https://painel.mangati.com/" target="_blank" rel="noopener" class="btn btn-secondary btn-sm w-100">
                            Acessar a plataforma <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-check"></i>
                {{ 'button.save'|trans }}
            </button>

            <a href="{{ path('novosga_panel_index') }}" class="btn btn-link text-decoration-none ms-2">
                <i class="fa fa-chevron-left"></i>
                {{ 'button.back'|trans }}
            </a>

            {% if entity.id %}
                <div class="ms-auto">
                    <button type="submit" form="form-delete" class="btn btn-danger">
                        <i class="fa fa-trash"></i>
                        {{ 'button.delete'|trans }}
                    </button>
                </div>
            {% endif %}
        </div>

    {{ form_end(form) }}

    {% if entity.id %}
        <form id="form-delete" method="post" action="{{ path('novosga_panel_delete', { id: entity.id }) }}" onsubmit="return confirm('{{ 'confirm.delete'|trans }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-painel-' ~ entity.id) }}">
        </form>
    {% endif %}
{% endblock %}
