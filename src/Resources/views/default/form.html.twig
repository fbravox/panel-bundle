{% extends "@NovosgaPanel/base.html.twig" %}

{% trans_default_domain 'NovosgaPanelBundle' %}

{% block body %}
    <div class="d-flex">
        <div>
            <h1>
                <i class="fa fa-tv" aria-hidden="true"></i> {{ 'title'|trans }}
            </h1>
            <p>{{ 'subtitle'|trans }}</p>
        </div>
    </div>

    {{ form_start(form) }}

        {% include 'flashMessages.html.twig' %}

        {{ form_row(form.nome) }}

        {{ form_row(form.servicos) }}

        <div class="d-flex align-items-center">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-check"></i>
                {{ 'button.save'|trans }}
            </button>

            {% if entity.id %}
                <a href="{{ path('painel_show', { publicId: entity.publicId }) }}" class="btn btn-outline-primary ms-2" target="_blank">
                    <i class="fa fa-tv"></i>
                    {{ 'button.open_painel'|trans }}
                </a>
            {% endif %}

            <a href="{{ path('novosga_panel_index') }}" class="btn btn-link text-decoration-none ms-2">
                <i class="fa fa-chevron-left"></i>
                {{ 'button.back'|trans }}
            </a>
        </div>

    {{ form_end(form) }}
{% endblock %}
