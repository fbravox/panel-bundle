{% extends "@NovosgaPanel/base.html.twig" %}

{% trans_default_domain 'NovosgaPanelBundle' %}

{% block body %}
    <div class="d-flex">
        <div>
            <h1>
                <i class="fa fa-tv" aria-hidden="true"></i> {{ 'title'|trans }}
            </h1>
            <p>{{ 'subtitle'|trans }}</p>
        </div>
        <div class="ms-auto mt-3">
            <a href="{{ path('novosga_panel_new') }}" class="btn btn-primary">
                <i class="fa fa-plus"></i>
                {{ 'button.new_painel'|trans }}
            </a>
        </div>
    </div>

    <table class="table table-hover border">
        <thead>
            <tr class="table-primary">
                <th>#</th>
                <th>{{ 'label.nome'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for painel in paineis %}
                <tr>
                    <td>{{ painel.id }}</td>
                    <td>{{ painel.nome }}</td>
                    <td class="text-end">
                        <a href="{{ path('painel_show', { publicId: painel.publicId }) }}" class="btn btn-outline-success" target="_blank">
                            <i class="fa fa-tv"></i>
                            {{ 'button.open_painel'|trans }}
                        </a>
                        <a href="{{ path('novosga_panel_edit', { id: painel.id }) }}" class="btn btn-secondary ms-1">
                            <i class="fa fa-edit"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
